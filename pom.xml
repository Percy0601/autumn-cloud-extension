<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>xyz.we-win.autumn</groupId>
    <artifactId>autumn-cloud-extension</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>autumn-cloud-extension</name>
    <description>Lightweight Spring Cloud Gateway discovery extensions: Consul / Nacos (HTTP API) and Multicast, with multi-lane traffic support</description>
    <url>https://github.com/Percy0601/autumn-cloud-extension</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>percy0601</id>
            <name>Percy Zhao</name>
            <email>745356640@qq.com</email>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Percy0601/autumn-cloud-extension</url>
        <connection>scm:git:git://github.com/Percy0601/autumn-cloud-extension.git</connection>
        <developerConnection>scm:git:ssh://github.com/Percy0601/autumn-cloud-extension.git</developerConnection>
        <tag>v1.1.0-SNAPSHOT</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <modules>
        <module>autumn-cloud-extension-common</module>
        <module>autumn-cloud-extension-config-consul-starter</module>
        <module>autumn-cloud-extension-config-nacos-starter</module>
        <module>autumn-cloud-extension-discovery-consul-starter</module>
        <module>autumn-cloud-extension-discovery-nacos-starter</module>
        <module>autumn-cloud-extension-discovery-multicast-starter</module>
        <module>autumn-cloud-extension-traffic-starter</module>
        <module>autumn-cloud-extension-propagation</module>
        <module>autumn-cloud-extension-propagation-starter</module>
        <!-- autumn-cloud-extension-starter-using 是示例模块，不发布 -->
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 库本身按 Java 17 字节码发布，兼容 17+ 运行时（含 Java 25 / autumn-gateway） -->
        <maven.compiler.release>17</maven.compiler.release>
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 仅用于版本对齐，common 模块不依赖任何 Spring 构件 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-config-consul-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-config-nacos-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-discovery-consul-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-discovery-nacos-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-discovery-multicast-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-traffic-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-propagation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>xyz.we-win.autumn</groupId>
                <artifactId>autumn-cloud-extension-propagation-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doclint>none</doclint>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.2</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.12.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <tokenAuth>true</tokenAuth>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
