<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>xyz.we-win.autumn</groupId>
        <artifactId>autumn-cloud-extension</artifactId>
        <version>1.0.0-RELEASE</version>
    </parent>

    <artifactId>autumn-cloud-extension-starter-using</artifactId>
    <name>autumn-cloud-extension-starter-using</name>
    <description>Usage example: provider + gateway with multi traffic-label routing (consul / nacos / multicast)</description>

    <properties>
        <spring-cloud-starter-gateway-server-webflux.version>5.0.3</spring-cloud-starter-gateway-server-webflux.version>
    </properties>

    <dependencies>
        <!-- Consul 配置中心 -->
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-cloud-extension-config-consul-starter</artifactId>
        </dependency>
        <!-- Nacos 配置中心 -->
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-cloud-extension-config-nacos-starter</artifactId>
        </dependency>
        <!-- Consul 服务发现 -->
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-cloud-extension-discovery-consul-starter</artifactId>
        </dependency>
        <!-- Nacos 服务发现 -->
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-cloud-extension-discovery-nacos-starter</artifactId>
        </dependency>
        <!-- 组播服务发现 -->
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-cloud-extension-discovery-multicast-starter</artifactId>
        </dependency>
        <!-- 泳道路由 -->
        <dependency>
            <groupId>xyz.we-win.autumn</groupId>
            <artifactId>autumn-cloud-extension-traffic-starter</artifactId>
        </dependency>
        <!-- Provider：普通 WebFlux 服务，注册自身并提供 /hello -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Gateway：lb:// 路由 + 流量标签过滤 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
            <version>${spring-cloud-starter-gateway-server-webflux.version}</version>
        </dependency>
        <!-- Spring Cloud Context：@RefreshScope 支持 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-context</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- 打包主类为网关；运行期用 -Dspring-boot.run.main-class 自由切换 -->
                            <mainClass>xyz.wewin.autumn.cloud.example.gateway.GatewayApplication</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
