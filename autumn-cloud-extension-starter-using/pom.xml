<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.autumn.cloud</groupId>
        <artifactId>autumn-cloud-extension</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>autumn-cloud-extension-starter-using</artifactId>
    <name>autumn-cloud-extension-starter-using</name>
    <description>Usage example: provider + gateway with multi traffic-label routing (consul / nacos / multicast)</description>

    <properties>
        <spring-cloud-starter-gateway-server-webflux.version>5.0.3</spring-cloud-starter-gateway-server-webflux.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.autumn.cloud</groupId>
            <artifactId>autumn-cloud-extension-starter</artifactId>
        </dependency>
        <!-- Provider：普通 WebFlux 服务，注册自身并提供 /hello -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Gateway：lb:// 路由 + 流量标签过滤 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
            <version>${spring-cloud-starter-gateway-server-webflux.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- 默认主类为网关；Provider 通过 -Dspring-boot.run.main-class 切换 -->
                    <mainClass>com.autumn.cloud.example.gateway.GatewayApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
